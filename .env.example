# Copy this file to ".env" (same folder as manage.py).

# ---------- Production / deploy ----------
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=YOUR_USERNAME.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://YOUR_USERNAME.pythonanywhere.com
# DJANGO_SERVE_MEDIA=True

# ---------- Email (Gmail App Password) ----------
# REQUIRED for real delivery (club Gmail as sender):
# 1. Turn on 2-Step Verification on the club Google account.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
#    (a normal Gmail password will NOT work).
# 3. Put that Gmail address in EMAIL_HOST_USER below AND in Admin →
#    Club Info → Email (same address).
# 4. Put the 16-character App Password in EMAIL_HOST_PASSWORD.
# 5. Restart the server, then run:
#       python manage.py send_test_email yourpersonal@gmail.com
#
# Note: free PythonAnywhere often blocks outbound SMTP — registrations
# still save in the admin even if email fails. See DEPLOY.md.

EMAIL_HOST_USER=your-club-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=your-club-email@gmail.com

# Optional overrides (defaults shown):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# CONTACT_NOTIFICATION_EMAIL=
